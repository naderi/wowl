{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wowl",
  "version": "1.0.0",
  "identifier": "com.alinaderi.wowl",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Wowl",
        "width": 1120,
        "height": 630,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Desktop & lock-screen wallpapers from Unsplash, Bing & more",
    "longDescription": "Wowl searches and sets desktop and lock-screen wallpapers from Unsplash, Bing's picture of the day, and Lorem Picsum.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
